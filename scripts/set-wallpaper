#!/usr/bin/env bash
set -euo pipefail

wallpaper_path="${1:-}"
fit_mode="${2:-cover}"
config_home="${XDG_CONFIG_HOME:-${HOME:-}/.config}"
hyprpaper_config="${HYPRPAPER_CONFIG:-${config_home}/hypr/hyprpaper.conf}"
log_file="${QUICKSHELL_WALLPAPER_LOG:-/tmp/quickshell-wallpaper.log}"

log() {
    printf '[%(%F %T)T] %s\n' -1 "$*" >> "$log_file"
}

if [[ -z "$wallpaper_path" ]]; then
    echo "usage: set-wallpaper <path> [fit_mode]" >&2
    exit 2
fi

if [[ ! -f "$wallpaper_path" ]]; then
    log "file not found: $wallpaper_path"
    echo "set-wallpaper: file not found: $wallpaper_path" >&2
    exit 1
fi

monitor_output="$(hyprctl monitors 2>/dev/null)" || {
    log "failed to query Hyprland monitors"
    echo "set-wallpaper: failed to query Hyprland monitors" >&2
    exit 1
}

mapfile -t monitors < <(awk '/^Monitor / { print $2 }' <<< "$monitor_output")

write_hyprpaper_config() {
    local tmp_config

    mkdir -p "$(dirname "$hyprpaper_config")"
    tmp_config="$(mktemp "${hyprpaper_config}.tmp.XXXXXX")"

    {
        printf '# Generated by quickshell/scripts/set-wallpaper\n\n'

        for monitor in "${monitors[@]}"; do
            cat <<EOF
wallpaper {
    monitor = ${monitor}
    path = ${wallpaper_path}
    fit_mode = ${fit_mode}
}

EOF
        done

        cat <<EOF
wallpaper {
    monitor =
    path = ${wallpaper_path}
    fit_mode = ${fit_mode}
}

splash = false
ipc = true
EOF
    } > "$tmp_config"

    mv "$tmp_config" "$hyprpaper_config"
}

restart_hyprpaper() {
    log "restarting hyprpaper with config: $hyprpaper_config"

    pkill -x hyprpaper >/dev/null 2>&1 || true

    if command -v setsid >/dev/null 2>&1; then
        setsid -f hyprpaper --config "$hyprpaper_config" >/tmp/hyprpaper.log 2>&1
    else
        nohup hyprpaper --config "$hyprpaper_config" >/tmp/hyprpaper.log 2>&1 &
    fi

    sleep 0.5

    if ! pgrep -x hyprpaper >/dev/null 2>&1; then
        log "hyprpaper was not running after restart"
        echo "set-wallpaper: failed to restart hyprpaper" >&2
        exit 1
    fi
}

write_hyprpaper_config
log "wrote $hyprpaper_config for $wallpaper_path"

restart_hyprpaper
